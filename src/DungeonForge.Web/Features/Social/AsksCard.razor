@inject DungeonApiClient Api
@inject GameSession Session
@using DungeonForge.Web.Core
@using DungeonForge.Web.Features.Dungeon

@* Private whispers: shards, your inbox, what you sent (with Reveal) and the composer (with Compel). Shown only for parties
   of more than three; the server decides that and says so in AsksAvailable. *@
@if (Me.AsksAvailable)
{
    <div id="asks" class="social-card">
        <p class="social-hint">Whisper-shards: <strong id="ask-tokens">@Me.AskTokens</strong> &middot; Your word: <strong id="standing">@Me.Standing</strong></p>
        @if (Me.Inbox.Count > 0)
        {
            <ul id="inbox" class="inbox">
                @foreach (var ask in Me.Inbox)
                {
                    <li class="inbox-ask">
                        <p><strong>@ask.From</strong> whispers (@ask.Kind): @ask.Text</p>
                        @if (ask.Replied)
                        {
                            <span class="social-hint">You answered.</span>
                        }
                        else
                        {
                            <input class="reply-text" maxlength="80" placeholder="Your answer" value="@ReplyText(ask)" @oninput="e => _replyText[ask.AskId] = e.Value?.ToString() ?? string.Empty" />
                            <button class="btn btn-ghost reply-honest" disabled="@_busy" @onclick='() => ReplyAsync(ask, "honest")'>I'll be honest</button>
                            <button class="btn btn-ghost reply-dodge" disabled="@_busy" @onclick='() => ReplyAsync(ask, "dodge")'>I'll dodge</button>
                            <button class="btn btn-ghost reply-bluff" disabled="@_busy" @onclick='() => ReplyAsync(ask, "bluff")'>I'll bluff</button>
                        }
                    </li>
                }
            </ul>
        }

        @if (Me.Sent.Count > 0)
        {
            <ul id="sent" class="sent">
                @foreach (var ask in Me.Sent)
                {
                    <li>To @string.Join(", ", ask.To): "@ask.Text"
                        @foreach (var reply in ask.Replies)
                        {
                            <div class="sent-reply"><strong>@reply.By</strong> @reply.Summary</div>
                        }
                        @if (ask.Replies.Count > 0)
                        {
                            <button class="btn btn-ghost reveal-ask" disabled="@_busy" title="Costs a point of your word" @onclick="() => RevealAsync(ask)">Lay it bare</button>
                        }
                    </li>
                }
            </ul>
        }

        <details id="ask-composer">
            <summary>Whisper to...</summary>
            <div class="ask-targets">
                @foreach (var other in Session.Members.Where(m => m.Name != Session.PlayerName && !m.IsDefeated))
                {
                    <label class="ask-target"><input type="checkbox" checked="@_to.Contains(other.Name)" @onchange="e => Toggle(other.Name, e.Value is true)" /> @other.Name</label>
                }
            </div>
            <select id="ask-kind" @bind="_kind">
                <option value="question">Question</option>
                <option value="accusation">Accuse</option>
                <option value="offer">Offer</option>
                <option value="plea">Plead</option>
            </select>
            <input id="ask-text" maxlength="140" placeholder="Costs 1 whisper-shard" @bind="_text" @bind:event="oninput" />
            <label class="ask-option"><input id="ask-compel" type="checkbox" @bind="_compel" /> Press them (costs a point of your word; no bluffing)</label>
            <button id="ask-send" class="btn btn-go" disabled="@(_busy || _to.Count == 0 || _text.Trim().Length == 0 || Me.AskTokens < _to.Count)" @onclick="SendAsync">Whisper</button>
        </details>

        @if (_error is not null)
        {
            <p id="asks-error" class="error">@_error</p>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public MySocialDto Me { get; set; } = default!;

    // Raised after any call that changed the overview, so the panel reloads.
    [Parameter] public EventCallback OnChanged { get; set; }

    private string _kind = "question";
    private string _text = "";
    private bool _compel;
    private readonly HashSet<string> _to = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _replyText = [];
    private string? _error;
    private bool _busy;

    private async Task RunAsync(Func<Task<string?>> action)
    {
        _busy = true;
        _error = null;
        try
        {
            _error = await action();
            await OnChanged.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private static string? Failure<T>(ApiResult<T> result) where T : class =>
        result.IsSuccess ? null : result.Error ?? "Something went wrong. Try again.";

    private void Toggle(string name, bool on)
    {
        if (on) _to.Add(name);
        else _to.Remove(name);
    }

    private string ReplyText(InboxAskDto ask) => _replyText.GetValueOrDefault(ask.AskId) ?? string.Empty;

    private Task SendAsync() => RunAsync(async () =>
    {
        var result = await Api.SendAskAsync(Session.PartyId, Session.PlayerName, [.. _to], _text.Trim(), _kind, compel: _compel);
        if (result.IsSuccess)
        {
            _text = "";
            _compel = false;
            _to.Clear();
        }

        return Failure(result);
    });

    private Task ReplyAsync(InboxAskDto ask, string choice) => RunAsync(async () =>
    {
        var text = _replyText.GetValueOrDefault(ask.AskId)?.Trim();
        return Failure(await Api.ReplyAskAsync(Session.PartyId, ask.AskId, Session.PlayerName, choice, string.IsNullOrEmpty(text) ? null : text));
    });

    private Task RevealAsync(SentAskDto ask) => RunAsync(async () =>
        Failure(await Api.RevealAskAsync(Session.PartyId, ask.AskId, Session.PlayerName)));
}
