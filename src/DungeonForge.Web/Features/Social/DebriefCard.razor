@inject DungeonApiClient Api
@inject GameSession Session
@using DungeonForge.Web.Core
@using DungeonForge.Web.Features.Dungeon
@using DungeonForge.Web.Features.Dungeon.Stage

@* The one place the hidden numbers appear, and only after the run, only for you, only if you ask. *@
<div id="debrief" class="social-card">
    @if (_debrief is not { OptedIn: true, Axes: not null } debrief)
    {
        <p class="social-prompt">Peek behind the curtain?</p>
        <button id="debrief-open" class="btn btn-go" disabled="@_busy" @onclick="OpenAsync">Show me how the dungeon saw me</button>
    }
    else
    {
        <p class="social-tags">The dungeon saw you as <strong>@string.Join(", ", debrief.Tags)</strong>.</p>
        <ul id="debrief-axes" class="debrief-list">
            @foreach (var axis in debrief.Axes!.OrderByDescending(a => Math.Abs(a.Value)))
            {
                <li><span class="debrief-name">@axis.Key</span> <strong>@axis.Value</strong></li>
            }
        </ul>
        @if (debrief.Abilities is { Count: > 0 })
        {
            <ul id="debrief-abilities" class="debrief-list">
                @foreach (var ability in debrief.Abilities)
                {
                    <li>@ability.Name (@ability.Rarity @ability.Archetype): @string.Join(", ", ability.Effects.Select(e => $"{e.Key} {e.Value}")), cooldown @ability.Cooldown</li>
                }
            </ul>
        }

        @if (debrief.Moments is { Count: > 0 })
        {
            <ul id="debrief-moments" class="debrief-list">
                @foreach (var moment in debrief.Moments)
                {
                    <li>Turn @moment.Turn, @moment.Verdict: @moment.Rationale</li>
                }
            </ul>
        }
    }

    @if (_error is not null)
    {
        <p id="debrief-error" class="error">@_error</p>
    }
</div>

@code {
    private DebriefDto? _debrief;
    private string? _error;
    private bool _busy;

    private async Task OpenAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var optIn = await Api.SetPreferencesAsync(Session.PartyId, Session.PlayerName, debriefOptIn: true);
            if (!optIn.IsSuccess)
            {
                _error = optIn.Error ?? "Something went wrong. Try again.";
                return;
            }

            var result = await Api.GetDebriefAsync(Session.PartyId, Session.PlayerName);
            if (result.IsSuccess) _debrief = result.Value;
            else _error = result.Error ?? "Something went wrong. Try again.";
        }
        finally
        {
            _busy = false;
        }
    }
}
