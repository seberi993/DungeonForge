@using DungeonForge.Web.Shared

<ul id="members" class="members party-panel">
    @for (var i = 0; i < Members.Count; i++)
    {
        var member = Members[i];
        var isMe = member.Name == MyName;
        var css = "member" + (member.IsDefeated ? " defeated-member" : "") + (isMe ? " me" : "");
        <li id="member-@i" class="@css">
            <div class="member-head">
                <span class="member-name">@member.Name</span>
                @if (member.IsDefeated)
                {
                    <span class="member-ko">KO</span>
                }
            </div>
            <StatBar Kind="hp" Label="HP" Value="member.Hp" Max="member.MaxHp" />
        </li>
    }
</ul>

@code {
    [Parameter] public IReadOnlyList<MemberDto> Members { get; set; } = [];
    [Parameter] public string? MyName { get; set; }
}
