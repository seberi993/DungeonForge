@page "/"
@using DungeonForge.Web.Models
@using DungeonForge.Web.Services
@inject DungeonApiClient Api
@inject GameSession Session
@inject NavigationManager Nav

<h1>DungeonForge</h1>
<p>Name your party and descend into the dungeon.</p>

<div class="card">
    <label for="party-name">Party name</label>
    <input id="party-name" @bind="_name" maxlength="50" disabled="@_busy" />
    <div id="roster" class="roster">
        @for (var i = 0; i < _roster.Count; i++)
        {
            var row = _roster[i];
            <div class="roster-row">
                <input id="member-name-@i" @bind="row.Name" maxlength="30" placeholder="Hero name" disabled="@_busy" />
                <select id="member-class-@i" @bind="row.Class" disabled="@_busy">
                    @foreach (var c in Enum.GetValues<CharacterClass>())
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            </div>
        }
        <button id="add-member" type="button" @onclick="AddMember" disabled="@(_busy || _roster.Count >= MaxRoster)">Add Member</button>
        <button id="remove-member" type="button" @onclick="RemoveMember" disabled="@(_busy || _roster.Count <= 1)">Remove Member</button>
    </div>
    <button id="create-party" @onclick="CreateAsync" disabled="@_busy">Create Party</button>
    @if (_error is not null)
    {
        <p class="validation-message">@_error</p>
    }
</div>

<div class="card">
    <label for="join-id">Join a friend's party (paste their invite code)</label>
    <input id="join-id" @bind="_joinId" placeholder="XXXX-XXXX" maxlength="40" disabled="@_busy" />
    <button id="join-party" @onclick="JoinAsync" disabled="@_busy">Join Party</button>
    @if (_joinError is not null)
    {
        <p class="join-error validation-message">@_joinError</p>
    }
</div>

@code {
    private string _joinId = "";
    private string? _joinError;

    private async Task JoinAsync()
    {
        _joinError = null;
        var input = _joinId.Trim();
        if (input.Length == 0)
        {
            _joinError = "Enter an invite code.";
            return;
        }

        _busy = true;
        try
        {
            // Short invite codes are the norm; a full party id (GUID) still works.
            var result = Guid.TryParse(input, out var id)
                ? await Api.GetPartyAsync(id)
                : await Api.GetPartyByCodeAsync(input);
            if (result.IsSuccess)
            {
                Session.Join(result.Value!);
                Nav.NavigateTo("/dungeon");
                return;
            }

            _joinError = result.Status == ApiStatus.NotFound
                ? "No party found with that invite code."
                : result.Error ?? "Could not join the party.";
        }
        finally
        {
            _busy = false;
        }
    }

    private const int MaxRoster = 6;

    private sealed class RosterRow
    {
        public string Name { get; set; } = "";
        public CharacterClass Class { get; set; } = CharacterClass.Warrior;
    }

    private readonly List<RosterRow> _roster = [new()];

    private void AddMember() { if (_roster.Count < MaxRoster) _roster.Add(new()); }

    private void RemoveMember() { if (_roster.Count > 1) _roster.RemoveAt(_roster.Count - 1); }

    private string _name = "";
    private string? _error;
    private bool _busy;

    private async Task CreateAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Api.CreatePartyAsync(_name, _roster.Select(r => new MemberRequest(r.Name, r.Class)).ToList());
            if (result.IsSuccess)
            {
                Session.Start(result.Value!);
                Nav.NavigateTo("/dungeon");
                return;
            }

            _error = result.Error ?? "Could not create the party.";
        }
        finally
        {
            _busy = false;
        }
    }
}
