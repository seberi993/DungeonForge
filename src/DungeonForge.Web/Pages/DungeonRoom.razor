@page "/dungeon"
@using DungeonForge.Shared
@using DungeonForge.Web.Models
@using DungeonForge.Web.Services
@using DungeonForge.Web.Components
@inject DungeonApiClient Api
@inject GameSession Session
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IDungeonHubClient Hub
@inject IServiceProvider Services
@implements IAsyncDisposable

@if (Session.HasParty)
{
    <div class="room">
    <header class="game-toolbar">
        <div class="toolbar-title">
            <h1>Dungeon</h1>
            <span id="stat-name" class="party-name">Party: @Session.Name</span>
        </div>
        <nav class="toolbar-actions" aria-label="Game menu">
            <button id="toggle-spellbook" type="button" class="btn btn-secondary" @onclick="() => _spellbookOpen = !_spellbookOpen"><span aria-hidden="true">📖</span> Spellbook</button>
            <details class="menu invite">
                <summary class="btn btn-secondary"><span aria-hidden="true">📨</span> Invite</summary>
                <div class="menu-panel">
                    <label for="invite-code">Share with friends so they can join</label>
                    <div class="invite-row">
                        <input id="invite-code" class="invite-code" readonly value="@Session.InviteCode" @onfocus="SelectInvite" />
                        <button id="copy-invite" class="btn btn-primary" @onclick="CopyInviteAsync">@(_copied ? "Copied!" : "Copy")</button>
                    </div>
                </div>
            </details>
            @if (_local is { State: not (LocalNarratorState.Unknown or LocalNarratorState.Unsupported) })
            {
                <details class="menu narrator-menu">
                    <summary class="btn btn-secondary"><span aria-hidden="true">🤖</span> Narrator</summary>
                    <div id="local-narrator" class="menu-panel local-narrator">
                        @switch (_local.State)
                        {
                            case LocalNarratorState.Idle:
                                <button id="enable-local-narrator" type="button" class="btn btn-primary" @onclick="_local.EnableAsync">Write the narration on my own GPU</button>
                                <small>Optional: a one-time ~1 GB download that stays in your browser. Needs a WebGPU browser (recent Chrome or Edge).</small>
                                break;
                            case LocalNarratorState.Downloading:
                                <label for="local-narrator-progress">Summoning the narrator: @_local.Status</label>
                                <progress id="local-narrator-progress" max="100" value="@_local.Progress"></progress>
                                break;
                            case LocalNarratorState.Ready:
                                <span id="local-narrator-ready">@(_localWriting ? "The local narrator is writing..." : "Local narrator ready")</span>
                                break;
                            case LocalNarratorState.Failed:
                                <span class="error">The local narrator could not start: @_local.Status</span>
                                <button id="retry-local-narrator" type="button" class="btn btn-primary" @onclick="_local.EnableAsync">Try again</button>
                                break;
                        }
                    </div>
                </details>
            }
            <button id="toggle-sound" type="button" class="btn btn-ghost" aria-pressed="@_muted.ToString().ToLowerInvariant()" @onclick="ToggleSoundAsync"><span aria-hidden="true">@(_muted ? "🔇" : "🔊")</span> @(_muted ? "Sound off" : "Sound on")</button>
        </nav>
    </header>

    <div class="hud" role="status">
        <span id="stat-floor" class="hud-chip chip-floor">Floor: @Session.Floor</span>
        <span id="stat-turn" class="hud-chip chip-turn">Turn: @Session.Turn</span>
        <span id="stat-gold" class="hud-chip chip-gold">Gold: @Session.Gold</span>
        <span id="stat-hp" class="hud-chip chip-hp">HP: @Session.TotalHp/@Session.TotalMaxHp</span>
    </div>

    <div class="room-grid">
    <aside class="room-side">
        <PartyPanel Members="Session.Members" MyName="@Session.PlayerName" Mana="Session.Mana" MaxMana="Session.MaxMana" />
        <SocialPanel />
        @if (Session.BossMaxHp > 0)
        {
            <div id="stat-boss" class="boss-panel"><StatBar Kind="boss" Label="BOSS" Value="Session.BossHp" Max="Session.BossMaxHp" /></div>
        }
    </aside>
    <div class="room-main">
    <AsciiStage Members="Session.Members" Turn="Session.Turn" Room="Session.PendingRoom" Scene="Session.Scene" Narration="Session.Scenario"
                Show="Session.Show" NarrationPending="@(Session.NarrationPending || Session.ScenarioPending)" OnShowComplete="OnShowComplete" OnCue="PlayCueAsync" />
    <SpellbookDrawer Class="Session.PlayerClass" Open="_spellbookOpen" OnClose="() => _spellbookOpen = false" OnSpellsLoaded="OnSpellsLoaded" />

    @if (_offline)
    {
        <p class="offline">Live updates offline. You can still explore.</p>
    }

    @if (Session.Show is not null && (ShowActive || Session.NarrationPending))
    {
        @* The stage acts the turn out and then waits for the narrator; the text below appears once it is done. *@
    }
    else if (Session.NarrationPending)
    {
        <p id="narration-loading" class="outcome loading">The dungeon master is narrating...</p>
    }
    else if (Session.LastOutcome is { } outcome)
    {
        <p id="last-outcome" class="outcome"><TypewriterText Text="@outcome" OnComplete="() => _outcomeTyped = outcome" /></p>
        @if (Session.NarrationSource == NarrationSources.Fallback)
        {
            <p id="fallback-note" class="fallback-note">The narrator is out of words, so this was canned text.</p>
        }
    }

    @if (Session.PrivateMessages.Count > 0)
    {
        <ul id="whispers" class="whispers" aria-label="Private whispers">
            @foreach (var message in Session.PrivateMessages)
            {
                <li class="whisper whisper-@message.Kind">
                    <span class="whisper-tag">@WhisperLabel(message.Kind)</span> @message.Text
                </li>
            }
        </ul>
    }

    @if (Session.IsDefeated)
    {
        <button id="explore" class="btn btn-primary btn-big" disabled>Explore Room</button>
    }
    else if (ShowActive)
    {
    }
    else if (Session.HasScenario)
    {
        <div id="scenario-panel" class="scenario-panel">
            <p id="scenario" class="scenario"><TypewriterText Text="@Session.Scenario" Hold="@(Session.LastOutcome is not null && _outcomeTyped != Session.LastOutcome)" /></p>
            <div id="action-box" class="action-box">
                <label for="action-text">What do you do?</label>
                <textarea id="action-text" maxlength="@Limits.MaxActionTextLength" disabled="@IsLocked" placeholder="@_suggestion" @bind="_actionText" @bind:event="oninput"></textarea>
                <div class="action-buttons">
                    <button id="lock-in" class="btn btn-go btn-big" disabled="@(_busy || IsLocked || string.IsNullOrWhiteSpace(_actionText))" @onclick="LockInAsync">@(IsLocked ? "Locked in" : "Lock in")</button>
                    @if (IsLocked)
                    {
                        <button id="unlock-turn" class="btn btn-ghost" disabled="@_busy" @onclick="UnlockAsync">Unlock</button>
                    }
                    <span class="char-count">@_actionText.Length/@MaxActionLength</span>
                </div>
            </div>
            <PartyLockStatus Status="Session.LockStatus" />
        </div>
    }
    else if (Session.ScenarioPending)
    {
        @if (Session.Show is null)
        {
            <p id="scenario-pending" class="scenario loading">The dungeon shifts...</p>
        }
    }
    else
    {
        <button id="explore" class="btn btn-primary btn-big" @onclick="ExploreAsync" disabled="@_busy">Explore Room</button>
    }

    @if (Session.IsDefeated)
    {
        <div class="defeated">
            <p class="game-over">GAME OVER</p>
            <p>Your party has been defeated.</p>
            <RunSummaryCard Summary="Session.Summary" />
            <HighScoresCard HighlightParty="@Session.Name" />
            <button id="new-party" class="btn btn-primary btn-big" @onclick="NewParty">New Party</button>
        </div>
    }

    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }

    @* Finished rooms live here, closed by default, so the main view only shows what is happening now. *@
    <details id="audit" class="audit">
        <summary>Journal (@Session.Log.Count @(Session.Log.Count == 1 ? "room" : "rooms"))</summary>
        <div id="log" class="log">
            @foreach (var entry in Session.Log)
            {
                <div class="log-entry">
                    <strong>Turn @entry.Turn</strong> (@RoomLabel(entry.RoomType)) @Describe(entry)
                    @if (entry.Scenario is not null)
                    {
                        <div class="log-scenario">@((MarkupString)Markup(entry.Scenario))</div>
                    }
                    <div>@entry.FlavorEvent</div>
                    @if (entry.Outcome is not null)
                    {
                        <div class="log-outcome">@((MarkupString)Markup(entry.Outcome))</div>
                    }
                </div>
            }
        </div>
    </details>
    </div>
    </div>
    </div>
}
