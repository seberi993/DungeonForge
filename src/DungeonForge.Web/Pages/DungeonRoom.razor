@page "/dungeon"
@using DungeonForge.Web.Models
@using DungeonForge.Web.Services
@inject DungeonApiClient Api
@inject GameSession Session
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IDungeonHubClient Hub
@implements IAsyncDisposable

@if (Session.HasParty)
{
    <h1>Dungeon</h1>
    <div class="stats">
        <span id="stat-name">Party: @Session.Name</span>
        <span id="stat-hp">HP: @Session.TotalHp/@Session.TotalMaxHp</span>
        <span id="stat-gold">Gold: @Session.Gold</span>
        <span id="stat-turn">Turn: @Session.Turn</span>
    </div>

    <ul id="members" class="members">
        @for (var i = 0; i < Session.Members.Count; i++)
        {
            var member = Session.Members[i];
            <li id="member-@i" class="member@(member.IsDefeated ? " defeated-member" : "")">
                <span class="member-name">@member.Name</span> (@member.Class) <span class="member-hp">@member.Hp/@member.MaxHp</span>
            </li>
        }
    </ul>

    <div class="card invite">
        <label for="invite-code">Invite code (share with friends so they can join)</label>
        <div class="invite-row">
            <input id="invite-code" class="invite-code" readonly value="@Session.InviteCode" @onfocus="SelectInvite" />
            <button id="copy-invite" @onclick="CopyInviteAsync">@(_copied ? "Copied!" : "Copy")</button>
        </div>
    </div>

    @if (_offline)
    {
        <p class="offline">Live updates offline. You can still explore.</p>
    }

    <button id="explore"@onclick="ExploreAsync" disabled="@(_busy || Session.IsDefeated)">Explore Room</button>

    @if (Session.IsDefeated)
    {
        <div class="defeated">
            <p>Your party has been defeated.</p>
            <button id="new-party" @onclick="NewParty">New Party</button>
        </div>
    }

    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }

    <div id="log" class="log">
        @foreach (var entry in Session.Log)
        {
            <div class="log-entry">
                <strong>Turn @entry.Turn</strong> (@RoomLabel(entry.RoomType)) @Describe(entry)
                <div>@entry.FlavorEvent</div>
            </div>
        }
    </div>
}

@code {
    private bool _busy;
    private string? _error;
    private bool _scroll;

    private bool _offline;
    private bool _disposed;
    private bool _copied;

    private async Task CopyInviteAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("dungeonForge.copyText", Session.InviteCode);
            _copied = true;
        }
        catch (JSException)
        {
            await SelectInvite();
        }
    }

    private async Task SelectInvite()
    {
        try { await JS.InvokeVoidAsync("dungeonForge.selectText", "invite-code"); }
        catch (JSException) { }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Session.HasParty)
        {
            Nav.NavigateTo("/");
            return;
        }

        Hub.TurnResolved += OnTurnResolved;
        Hub.PartyUpdated += OnPartyUpdated;
        try
        {
            await Hub.ConnectAsync(Session.PartyId);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _offline = true;
        }
    }

    private void OnTurnResolved(ExploreResponse result)
    {
        if (_disposed) return;
        try
        {
            _ = InvokeAsync(() =>
            {
                if (_disposed || !Session.ApplyRemote(result)) return;
                _scroll = true;
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private void OnPartyUpdated(PartyStateDto state)
    {
        // Turn events carry the full state; PartyUpdated is reserved for roster changes.
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Hub.TurnResolved -= OnTurnResolved;
        Hub.PartyUpdated -= OnPartyUpdated;
        await Hub.DisposeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scroll) return;
        _scroll = false;
        await JS.InvokeVoidAsync("dungeonForge.scrollToBottom", "log");
    }

    private async Task ExploreAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Api.ExploreAsync(Session.PartyId);
            switch (result.Status)
            {
                case ApiStatus.Success:
                    if (Session.Apply(result.Value!)) _scroll = true;
                    break;
                case ApiStatus.Conflict:
                    Session.MarkDefeated();
                    break;
                case ApiStatus.NotFound:
                    Session.Clear();
                    Nav.NavigateTo("/");
                    break;
                default:
                    _error = result.Error ?? "Something went wrong. Try again.";
                    break;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private void NewParty()
    {
        Session.Clear();
        Nav.NavigateTo("/");
    }

    private static string RoomLabel(RoomType type) => type == RoomType.Chest ? "chest" : "combat";

    private static string Describe(LogEntry entry) => entry.RoomType == RoomType.Combat
        ? (entry.TargetName is null ? "No damage" : $"{entry.TargetName} took {entry.Damage} damage")
        : $"Gold +{entry.GoldFound}";
}
