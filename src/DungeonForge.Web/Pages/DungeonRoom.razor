@page "/dungeon"
@using DungeonForge.Web.Models
@using DungeonForge.Web.Services
@using DungeonForge.Web.Components
@inject DungeonApiClient Api
@inject GameSession Session
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IDungeonHubClient Hub
@inject IServiceProvider Services
@implements IAsyncDisposable

@if (Session.HasParty)
{
    <h1>Dungeon</h1>
    <div class="stats">
        <span id="stat-name">Party: @Session.Name</span>
        <span id="stat-hp">HP: @Session.TotalHp/@Session.TotalMaxHp</span>
        <span id="stat-gold">Gold: @Session.Gold</span>
        <span id="stat-turn">Turn: @Session.Turn</span>
        <span id="stat-floor">Floor: @Session.Floor</span>
        @if (Session.BossMaxHp > 0)
        {
            <span id="stat-boss">Boss: @Session.BossHp/@Session.BossMaxHp</span>
        }
        <button id="toggle-sound" type="button" class="link-button" aria-pressed="@_muted.ToString().ToLowerInvariant()" @onclick="ToggleSoundAsync">@(_muted ? "Sound off" : "Sound on")</button>
    </div>

    <ul id="members" class="members">
        @for (var i = 0; i < Session.Members.Count; i++)
        {
            var member = Session.Members[i];
            var memberClass = "member" + (member.IsDefeated ? " defeated-member" : "") + (member.Name == Session.PlayerName ? " me" : "");
            <li id="member-@i" class="@memberClass">
                <span class="member-name">@member.Name</span> (@member.Class) <span class="member-hp">@member.Hp/@member.MaxHp</span>
                <div class="hp-bar" role="progressbar" aria-valuemin="0" aria-valuenow="@member.Hp" aria-valuemax="@member.MaxHp">
                    <div class="@HpFillClass(member)" style="width:@HpPercent(member)%"></div>
                </div>
            </li>
        }
    </ul>

    <details class="card invite">
        <summary>Invite code</summary>
        <label for="invite-code">Share with friends so they can join</label>
        <div class="invite-row">
            <input id="invite-code" class="invite-code" readonly value="@Session.InviteCode" @onfocus="SelectInvite" />
            <button id="copy-invite" @onclick="CopyInviteAsync">@(_copied ? "Copied!" : "Copy")</button>
        </div>
    </details>

    @if (_local is { State: not (LocalNarratorState.Unknown or LocalNarratorState.Unsupported) })
    {
        <div id="local-narrator" class="card local-narrator">
            @switch (_local.State)
            {
                case LocalNarratorState.Idle:
                    <button id="enable-local-narrator" type="button" @onclick="_local.EnableAsync">Write the narration on my own GPU</button>
                    <small>Optional: a one-time ~1 GB download that stays in your browser. Needs a WebGPU browser (recent Chrome or Edge).</small>
                    break;
                case LocalNarratorState.Downloading:
                    <label for="local-narrator-progress">Summoning the narrator: @_local.Status</label>
                    <progress id="local-narrator-progress" max="100" value="@_local.Progress"></progress>
                    break;
                case LocalNarratorState.Ready:
                    <span id="local-narrator-ready">@(_localWriting ? "The local narrator is writing..." : "Local narrator ready")</span>
                    break;
                case LocalNarratorState.Failed:
                    <span class="error">The local narrator could not start: @_local.Status</span>
                    <button id="retry-local-narrator" type="button" @onclick="_local.EnableAsync">Try again</button>
                    break;
            }
        </div>
    }

    <AsciiStage Members="Session.Members" Turn="Session.Turn" Room="Session.PendingRoom" Scene="Session.Scene" Narration="Session.Scenario"
                Show="Session.Show" NarrationPending="@(Session.NarrationPending || Session.ScenarioPending)" OnShowComplete="OnShowComplete" OnCue="PlayCueAsync" />
    <SpellbookDrawer Class="Session.PlayerClass" Open="_spellbookOpen" OnClose="() => _spellbookOpen = false" OnSpellsLoaded="OnSpellsLoaded" />

    @if (_offline)
    {
        <p class="offline">Live updates offline. You can still explore.</p>
    }

    @if (Session.Show is not null && (ShowActive || Session.NarrationPending))
    {
        @* The stage acts the turn out and then waits for the narrator; the text below appears once it is done. *@
    }
    else if (Session.NarrationPending)
    {
        <p id="narration-loading" class="outcome loading">The dungeon master is narrating...</p>
    }
    else if (Session.LastOutcome is { } outcome)
    {
        <p id="last-outcome" class="outcome"><TypewriterText Text="@outcome" OnComplete="() => _outcomeTyped = outcome" /></p>
        @if (Session.NarrationSource == "fallback")
        {
            <p id="fallback-note" class="fallback-note">The narrator is out of words, so this was canned text.</p>
        }
    }

    @if (Session.IsDefeated)
    {
        <button id="explore" disabled>Explore Room</button>
    }
    else if (ShowActive)
    {
    }
    else if (Session.HasScenario)
    {
        <div id="scenario-panel" class="scenario-panel">
            <p id="scenario" class="scenario"><TypewriterText Text="@Session.Scenario" Hold="@(Session.LastOutcome is not null && _outcomeTyped != Session.LastOutcome)" /></p>
            <div id="action-box" class="action-box">
                <label for="action-text">What do you do?</label>
                <textarea id="action-text" maxlength="200" disabled="@IsLocked" placeholder="@_suggestion" style="--sugg-hue: @_suggestionHue" @bind="_actionText" @bind:event="oninput"></textarea>
                <div class="action-buttons">
                    <button id="toggle-spellbook" type="button" @onclick="() => _spellbookOpen = !_spellbookOpen">Spellbook</button>
                    <button id="lock-in" disabled="@(_busy || IsLocked || string.IsNullOrWhiteSpace(_actionText))" @onclick="LockInAsync">@(IsLocked ? "Locked in" : "Lock in")</button>
                    @if (IsLocked)
                    {
                        <button id="unlock-turn" disabled="@_busy" @onclick="UnlockAsync">Unlock</button>
                    }
                </div>
            </div>
            <PartyLockStatus Status="Session.LockStatus" />
            @if (Session.Discussion.Count > 0)
            {
                <ul id="discussion" class="discussion">
                    @foreach (var action in Session.Discussion)
                    {
                        <li><strong>@action.Name</strong>: @action.Text</li>
                    }
                </ul>
            }
        </div>
    }
    else if (Session.ScenarioPending)
    {
        @if (Session.Show is null)
        {
            <p id="scenario-pending" class="scenario loading">The dungeon shifts...</p>
        }
    }
    else
    {
        <button id="explore" @onclick="ExploreAsync" disabled="@_busy">Explore Room</button>
    }

    @if (Session.IsDefeated)
    {
        <div class="defeated">
            <p>Your party has been defeated.</p>
            <RunSummaryCard Summary="Session.Summary" />
            <button id="new-party" @onclick="NewParty">New Party</button>
        </div>
    }

    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }

    @* Finished rooms live here, closed by default, so the main view only shows what is happening now. *@
    <details id="audit" class="audit">
        <summary>Audit history (@Session.Log.Count @(Session.Log.Count == 1 ? "room" : "rooms"))</summary>
        <div id="log" class="log">
            @foreach (var entry in Session.Log)
            {
                <div class="log-entry">
                    <strong>Turn @entry.Turn</strong> (@RoomLabel(entry.RoomType)) @Describe(entry)
                    @if (entry.Scenario is not null)
                    {
                        <div class="log-scenario">@((MarkupString)Markup(entry.Scenario))</div>
                    }
                    <div>@entry.FlavorEvent</div>
                    @if (entry.Outcome is not null)
                    {
                        <div class="log-outcome">@((MarkupString)Markup(entry.Outcome))</div>
                    }
                </div>
            }
        </div>
    </details>
}

@code {
    private static int HpPercent(MemberDto m) =>
        m.MaxHp <= 0 ? 0 : (int)Math.Round(Math.Clamp(m.Hp, 0, m.MaxHp) * 100.0 / m.MaxHp);

    private static string HpFillClass(MemberDto m) => HpPercent(m) <= 30 ? "hp-fill hp-low" : "hp-fill";

    private bool _busy;
    private string? _error;
    private bool _scroll;

    private bool _offline;
    private bool _disposed;
    private bool _copied;
    private string _actionText = "";
    private CancellationTokenSource? _narrationCts;

    // Faint rotating hint shown while the action box is empty.
    private readonly Random _rng = new();
    private IReadOnlyList<string>? _spellNames;
    private string _suggestion = "";
    private int _suggestionHue;
    private Timer? _suggestionTimer;

    private void Reroll()
    {
        _suggestion = ActionSuggestions.Pick(_rng, _spellNames);
        _suggestionHue = ActionSuggestions.PickHue(_rng);
    }

    private void OnSpellsLoaded(IReadOnlyList<string> names) => _spellNames = names;

    private void StartSuggestionTimer() =>
        _suggestionTimer = new Timer(_ => Dispatch(() =>
        {
            if (!string.IsNullOrEmpty(_actionText)) return false;
            Reroll();
            return true;
        }), null, TimeSpan.FromSeconds(8), TimeSpan.FromSeconds(8));

    // The stage tells us when it has acted out a turn; until then the outcome and next scenario stay hidden.
    private int _showDoneTurn;
    private bool ShowActive => Session.Show is { } show && show.Turn > _showDoneTurn;

    private void OnShowComplete(int turn) => _showDoneTurn = Math.Max(_showDoneTurn, turn);

    // Longer than the server's client-narration deadline plus its own narrator call, so a slow local model is not abandoned early.
    [Parameter] public TimeSpan NarrationTimeout { get; set; } = TimeSpan.FromSeconds(60);

    private ILocalNarrator? _local;
    private bool _localWriting;

    private void OnLocalChanged() => Dispatch(() => true);

    // Runs the server's prompts on this browser's model and hands the text back; no model (or a decline) lets the server write it.
    private async Task NarrateLocallyAsync(NarrationBrief brief)
    {
        string? text = null;
        if (_local is { State: LocalNarratorState.Ready })
        {
            _localWriting = true;
            await InvokeAsync(StateHasChanged);
            try
            {
                using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(45));
                text = await _local.GenerateAsync(brief, cts.Token);
            }
            finally
            {
                _localWriting = false;
                if (!_disposed) await InvokeAsync(StateHasChanged);
            }
        }

        await Api.SubmitNarrationAsync(Session.PartyId, brief.Turn, text, declined: text is null);
    }

    private async Task CopyInviteAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("dungeonForge.copyText", Session.InviteCode);
            _copied = true;
        }
        catch (JSException)
        {
            await SelectInvite();
        }
    }

    private async Task SelectInvite()
    {
        try { await JS.InvokeVoidAsync("dungeonForge.selectText", "invite-code"); }
        catch (JSException) { }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Session.HasParty)
        {
            Nav.NavigateTo("/");
            return;
        }

        Reroll();
        StartSuggestionTimer();
        _local = Services.GetService(typeof(ILocalNarrator)) as ILocalNarrator;
        if (_local is not null)
        {
            _local.Changed += OnLocalChanged;
            _ = _local.InitializeAsync();
        }

        Hub.TurnResolved += OnTurnResolved;
        Hub.PartyUpdated += OnPartyUpdated;
        Hub.NarrationReady += OnNarrationReady;
        Hub.DiscussionUpdated += OnDiscussionUpdated;
        Hub.TurnLockUpdated += OnTurnLockUpdated;
        try
        {
            await Hub.ConnectAsync(Session.PartyId);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _offline = true;
        }
    }

    private void OnTurnResolved(ExploreResponse result)
    {
        if (_disposed) return;
        try
        {
            _ = InvokeAsync(() =>
            {
                if (_disposed || !Session.ApplyRemote(result)) return;
                _scroll = true;
                WatchNarration();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private void OnNarrationReady(NarrationReady narration) =>
        Dispatch(() => Session.ApplyNarration(narration.PartyId, narration.Turn, narration.Outcome, narration.NextScenario, narration.NextRoomType, narration.NextScene, narration.Source));

    private void OnDiscussionUpdated(Guid partyId, IReadOnlyList<PlayerAction> actions) =>
        Dispatch(() => Session.ApplyDiscussion(partyId, actions));

    // Session raises Changed itself, so the callback only needs to re-render.
    private void Dispatch(Func<bool> apply)
    {
        if (_disposed) return;
        try
        {
            _ = InvokeAsync(() =>
            {
                if (_disposed || !apply()) return;
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private void WatchNarration()
    {
        _narrationCts?.Cancel();
        _narrationCts?.Dispose();
        _narrationCts = null;
        if (!Session.NarrationPending && !Session.ScenarioPending) return;

        var cts = _narrationCts = new CancellationTokenSource();
        var turn = Session.Turn;
        _ = ExpireAfterAsync(turn, cts.Token);
    }

    private async Task ExpireAfterAsync(int turn, CancellationToken ct)
    {
        try
        {
            await Task.Delay(NarrationTimeout, ct);
            await InvokeAsync(() =>
            {
                if (_disposed || !Session.ExpireNarration(turn)) return;
                StateHasChanged();
            });
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
        }
    }

    private void OnPartyUpdated(PartyStateDto state)
    {
        if (_disposed) return;
        try
        {
            _ = InvokeAsync(() =>
            {
                if (_disposed || !Session.ApplyPartyState(state)) return;
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _suggestionTimer?.Dispose();
        if (_local is not null) _local.Changed -= OnLocalChanged;
        Hub.TurnResolved -= OnTurnResolved;
        Hub.PartyUpdated -= OnPartyUpdated;
        Hub.NarrationReady -= OnNarrationReady;
        Hub.DiscussionUpdated -= OnDiscussionUpdated;
        Hub.TurnLockUpdated -= OnTurnLockUpdated;
        _narrationCts?.Cancel();
        _narrationCts?.Dispose();
        await Hub.DisposeAsync();
    }

    // Sound is a nicety: a blocked or missing audio module must never break the game.
    private bool _muted;

    private async Task PlayCueAsync(string cue)
    {
        try { await JS.InvokeVoidAsync("dungeonForge.sfx.play", cue); }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException) { }
    }

    private async Task ToggleSoundAsync()
    {
        try { _muted = await JS.InvokeAsync<bool>("dungeonForge.sfx.toggle"); }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var muted = await JS.InvokeAsync<bool>("dungeonForge.sfx.isMuted");
                if (muted != _muted)
                {
                    _muted = muted;
                    StateHasChanged();
                }
            }
            catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException) { }
        }

        if (!_scroll) return;
        _scroll = false;
        await JS.InvokeVoidAsync("dungeonForge.scrollToBottom", "log");
    }

    private const int MaxActionLength = 200;
    private bool _spellbookOpen;
    private int? _lockedTurn;

    private bool IsLocked => _lockedTurn == Session.Turn;

    private void OnTurnLockUpdated(Guid partyId, IReadOnlyList<LockStatusDto> status) =>
        Dispatch(() => Session.ApplyLockStatus(partyId, status));

    private Task ExploreAsync() => SendAsync(null);

    private Task LockInAsync()
    {
        var text = _actionText.Trim();
        return text.Length == 0
            ? Task.CompletedTask
            : SendAsync([new PlayerAction(Session.PlayerId, Session.PlayerName, text)], submitOnly: true);
    }

    private async Task UnlockAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Api.UnlockAsync(Session.PartyId, Session.PlayerId);
            switch (result.Status)
            {
                case ApiStatus.Success:
                    _lockedTurn = null;
                    Session.ApplyLockStatus(Session.PartyId, result.Value!.LockStatus);
                    break;
                case ApiStatus.NotFound:
                    Session.Clear();
                    Nav.NavigateTo("/");
                    break;
                default:
                    _error = result.Error ?? "Something went wrong. Try again.";
                    break;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SendAsync(IReadOnlyList<PlayerAction>? actions, bool submitOnly = false)
    {
        _busy = true;
        _error = null;
        var locking = actions is { Count: > 0 } && submitOnly;
        try
        {
            var result = await Api.ExploreAsync(Session.PartyId, actions, submitOnly);
            switch (result.Status)
            {
                case ApiStatus.Success:
                    var response = result.Value!;
                    var lockedAtTurn = Session.Turn;
                    // Only the request that claimed the narration slot is briefed; the server falls back if we never answer.
                    if (response.Brief is { } brief) _ = NarrateLocallyAsync(brief);
                    // The last lock-in resolves the turn server-side and answers with the resolved (newer) turn.
                    if (Session.Apply(response))
                    {
                        _scroll = true;
                        _actionText = "";
                        Reroll();
                        _lockedTurn = null;
                        WatchNarration();
                    }
                    else
                    {
                        if (locking) _lockedTurn = lockedAtTurn;
                        if (Session.ApplyPrompt(response)) WatchNarration();
                    }
                    break;
                case ApiStatus.Waiting:
                    if (locking) _lockedTurn = Session.Turn;
                    break;
                case ApiStatus.Conflict:
                    Session.MarkDefeated();
                    break;
                case ApiStatus.NotFound:
                    Session.Clear();
                    Nav.NavigateTo("/");
                    break;
                default:
                    _error = result.Error ?? "Something went wrong. Try again.";
                    break;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private void NewParty()
    {
        Session.Clear();
        Nav.NavigateTo("/");
    }

    // Outcome text last fully typed; the next scenario waits for it so two blocks never type at once.
    private string? _outcomeTyped;

    // HTML-encoded, with **word** highlights as spans (audit entries are shown whole, not typed).
    private static string Markup(string text) => string.Concat(TypewriterText.Parse(text).Select(s =>
        s.Key ? $"<span class=\"key\">{System.Net.WebUtility.HtmlEncode(s.Text)}</span>" : System.Net.WebUtility.HtmlEncode(s.Text)));

    private static string RoomLabel(RoomType type) => type switch { RoomType.Chest => "chest", RoomType.Puzzle => "puzzle", RoomType.Boss => "boss", _ => "combat" };

    private static string Describe(LogEntry entry) => entry.RoomType is RoomType.Combat or RoomType.Boss
        ? (entry.TargetName is null ? "No damage" : $"{entry.TargetName} took {entry.Damage} damage")
        : entry.RoomType == RoomType.Puzzle && entry.GoldFound == 0 && entry.Damage > 0
            ? $"{entry.TargetName ?? "A hero"} took {entry.Damage} damage"
            : $"Gold +{entry.GoldFound}";
}
