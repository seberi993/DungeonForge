@page "/dungeon"
@using DungeonForge.Web.Models
@using DungeonForge.Web.Services
@using DungeonForge.Web.Components
@inject DungeonApiClient Api
@inject GameSession Session
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IDungeonHubClient Hub
@implements IAsyncDisposable

@if (Session.HasParty)
{
    <h1>Dungeon</h1>
    <div class="stats">
        <span id="stat-name">Party: @Session.Name</span>
        <span id="stat-hp">HP: @Session.TotalHp/@Session.TotalMaxHp</span>
        <span id="stat-gold">Gold: @Session.Gold</span>
        <span id="stat-turn">Turn: @Session.Turn</span>
    </div>

    <ul id="members" class="members">
        @for (var i = 0; i < Session.Members.Count; i++)
        {
            var member = Session.Members[i];
            var memberClass = "member" + (member.IsDefeated ? " defeated-member" : "") + (member.Name == Session.PlayerName ? " me" : "");
            <li id="member-@i" class="@memberClass">
                <span class="member-name">@member.Name</span> (@member.Class) <span class="member-hp">@member.Hp/@member.MaxHp</span>
            </li>
        }
    </ul>

    <div class="card invite">
        <label for="invite-code">Invite code (share with friends so they can join)</label>
        <div class="invite-row">
            <input id="invite-code" class="invite-code" readonly value="@Session.InviteCode" @onfocus="SelectInvite" />
            <button id="copy-invite" @onclick="CopyInviteAsync">@(_copied ? "Copied!" : "Copy")</button>
        </div>
    </div>

    <DungeonMinimap Log="Session.Log" Members="Session.Members" PendingRoom="Session.PendingRoom" />
    <SpellbookDrawer Class="Session.PlayerClass" Open="_spellbookOpen" OnSelect="CastSpell" OnClose="() => _spellbookOpen = false" />

    @if (_offline)
    {
        <p class="offline">Live updates offline. You can still explore.</p>
    }

    @if (Session.IsDefeated)
    {
        <button id="explore" disabled>Explore Room</button>
    }
    else if (Session.HasScenario)
    {
        <div id="scenario-panel" class="scenario-panel">
            <p id="scenario" class="scenario">@Session.Scenario</p>
            <div id="action-box" class="action-box">
                <label for="action-text">What do you do?</label>
                <textarea id="action-text" maxlength="200" disabled="@IsLocked" @bind="_actionText" @bind:event="oninput"></textarea>
                <div class="action-buttons">
                    <button id="toggle-spellbook" type="button" @onclick="() => _spellbookOpen = !_spellbookOpen">Spellbook</button>
                    <button id="lock-in" disabled="@(_busy || IsLocked || string.IsNullOrWhiteSpace(_actionText))" @onclick="LockInAsync">@(IsLocked ? "Locked in" : "Lock in")</button>
                    @if (IsLocked)
                    {
                        <button id="unlock-turn" disabled="@_busy" @onclick="UnlockAsync">Unlock</button>
                    }
                </div>
            </div>
            <PartyLockStatus Status="Session.LockStatus" />
            @if (Session.Discussion.Count > 0)
            {
                <ul id="discussion" class="discussion">
                    @foreach (var action in Session.Discussion)
                    {
                        <li><strong>@action.Name</strong>: @action.Text</li>
                    }
                </ul>
            }
        </div>
    }
    else if (Session.ScenarioPending)
    {
        <p id="scenario-pending" class="scenario loading">The dungeon shifts...</p>
    }
    else
    {
        <button id="explore" @onclick="ExploreAsync" disabled="@_busy">Explore Room</button>
    }

    @if (Session.NarrationPending)
    {
        <p id="narration-loading" class="outcome loading">The dungeon master is narrating...</p>
    }
    else if (Session.LastOutcome is not null)
    {
        <p id="last-outcome" class="outcome">@Session.LastOutcome</p>
    }

    @if (Session.IsDefeated)
    {
        <div class="defeated">
            <p>Your party has been defeated.</p>
            <button id="new-party" @onclick="NewParty">New Party</button>
        </div>
    }

    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }

    <div id="log" class="log">
        @foreach (var entry in Session.Log)
        {
            <div class="log-entry">
                <strong>Turn @entry.Turn</strong> (@RoomLabel(entry.RoomType)) @Describe(entry)
                <div>@entry.FlavorEvent</div>
                @if (entry.Outcome is not null)
                {
                    <div class="log-outcome">@entry.Outcome</div>
                }
            </div>
        }
    </div>
}

@code {
    private bool _busy;
    private string? _error;
    private bool _scroll;

    private bool _offline;
    private bool _disposed;
    private bool _copied;
    private string _actionText = "";
    private CancellationTokenSource? _narrationCts;

    [Parameter] public TimeSpan NarrationTimeout { get; set; } = TimeSpan.FromSeconds(20);

    private async Task CopyInviteAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("dungeonForge.copyText", Session.InviteCode);
            _copied = true;
        }
        catch (JSException)
        {
            await SelectInvite();
        }
    }

    private async Task SelectInvite()
    {
        try { await JS.InvokeVoidAsync("dungeonForge.selectText", "invite-code"); }
        catch (JSException) { }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Session.HasParty)
        {
            Nav.NavigateTo("/");
            return;
        }

        Hub.TurnResolved += OnTurnResolved;
        Hub.PartyUpdated += OnPartyUpdated;
        Hub.NarrationReady += OnNarrationReady;
        Hub.DiscussionUpdated += OnDiscussionUpdated;
        Hub.TurnLockUpdated += OnTurnLockUpdated;
        try
        {
            await Hub.ConnectAsync(Session.PartyId);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _offline = true;
        }
    }

    private void OnTurnResolved(ExploreResponse result)
    {
        if (_disposed) return;
        try
        {
            _ = InvokeAsync(() =>
            {
                if (_disposed || !Session.ApplyRemote(result)) return;
                _scroll = true;
                WatchNarration();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private void OnNarrationReady(NarrationReady narration) =>
        Dispatch(() => Session.ApplyNarration(narration.PartyId, narration.Turn, narration.Outcome, narration.NextScenario, narration.NextRoomType));

    private void OnDiscussionUpdated(Guid partyId, IReadOnlyList<PlayerAction> actions) =>
        Dispatch(() => Session.ApplyDiscussion(partyId, actions));

    // Session raises Changed itself, so the callback only needs to re-render.
    private void Dispatch(Func<bool> apply)
    {
        if (_disposed) return;
        try
        {
            _ = InvokeAsync(() =>
            {
                if (_disposed || !apply()) return;
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private void WatchNarration()
    {
        _narrationCts?.Cancel();
        _narrationCts?.Dispose();
        _narrationCts = null;
        if (!Session.NarrationPending && !Session.ScenarioPending) return;

        var cts = _narrationCts = new CancellationTokenSource();
        var turn = Session.Turn;
        _ = ExpireAfterAsync(turn, cts.Token);
    }

    private async Task ExpireAfterAsync(int turn, CancellationToken ct)
    {
        try
        {
            await Task.Delay(NarrationTimeout, ct);
            await InvokeAsync(() =>
            {
                if (_disposed || !Session.ExpireNarration(turn)) return;
                StateHasChanged();
            });
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
        }
    }

    private void OnPartyUpdated(PartyStateDto state)
    {
        if (_disposed) return;
        try
        {
            _ = InvokeAsync(() =>
            {
                if (_disposed || !Session.ApplyPartyState(state)) return;
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Hub.TurnResolved -= OnTurnResolved;
        Hub.PartyUpdated -= OnPartyUpdated;
        Hub.NarrationReady -= OnNarrationReady;
        Hub.DiscussionUpdated -= OnDiscussionUpdated;
        Hub.TurnLockUpdated -= OnTurnLockUpdated;
        _narrationCts?.Cancel();
        _narrationCts?.Dispose();
        await Hub.DisposeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scroll) return;
        _scroll = false;
        await JS.InvokeVoidAsync("dungeonForge.scrollToBottom", "log");
    }

    private const int MaxActionLength = 200;
    private bool _spellbookOpen;
    private int? _lockedTurn;

    private bool IsLocked => _lockedTurn == Session.Turn;

    private void OnTurnLockUpdated(Guid partyId, IReadOnlyList<LockStatusDto> status) =>
        Dispatch(() => Session.ApplyLockStatus(partyId, status));

    private void CastSpell(SpellDto spell)
    {
        if (IsLocked) return;
        var cast = $"Cast {spell.Name}";
        var text = _actionText.Trim();
        var combined = text.Length == 0 ? cast : $"{text}. {cast}";
        _actionText = combined.Length <= MaxActionLength ? combined : cast;
        _spellbookOpen = false;
    }

    private Task ExploreAsync() => SendAsync(null);

    private Task LockInAsync()
    {
        var text = _actionText.Trim();
        return text.Length == 0
            ? Task.CompletedTask
            : SendAsync([new PlayerAction(Session.PlayerId, Session.PlayerName, text)], submitOnly: true);
    }

    private async Task UnlockAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Api.UnlockAsync(Session.PartyId, Session.PlayerId);
            switch (result.Status)
            {
                case ApiStatus.Success:
                    _lockedTurn = null;
                    Session.ApplyLockStatus(Session.PartyId, result.Value!.LockStatus);
                    break;
                case ApiStatus.NotFound:
                    Session.Clear();
                    Nav.NavigateTo("/");
                    break;
                default:
                    _error = result.Error ?? "Something went wrong. Try again.";
                    break;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SendAsync(IReadOnlyList<PlayerAction>? actions, bool submitOnly = false)
    {
        _busy = true;
        _error = null;
        var locking = actions is { Count: > 0 } && submitOnly;
        try
        {
            var result = await Api.ExploreAsync(Session.PartyId, actions, submitOnly);
            switch (result.Status)
            {
                case ApiStatus.Success:
                    var response = result.Value!;
                    var lockedAtTurn = Session.Turn;
                    // The last lock-in resolves the turn server-side and answers with the resolved (newer) turn.
                    if (Session.Apply(response))
                    {
                        _scroll = true;
                        _actionText = "";
                        _lockedTurn = null;
                        WatchNarration();
                    }
                    else
                    {
                        if (locking) _lockedTurn = lockedAtTurn;
                        if (Session.ApplyPrompt(response)) WatchNarration();
                    }
                    break;
                case ApiStatus.Waiting:
                    if (locking) _lockedTurn = Session.Turn;
                    break;
                case ApiStatus.Conflict:
                    Session.MarkDefeated();
                    break;
                case ApiStatus.NotFound:
                    Session.Clear();
                    Nav.NavigateTo("/");
                    break;
                default:
                    _error = result.Error ?? "Something went wrong. Try again.";
                    break;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private void NewParty()
    {
        Session.Clear();
        Nav.NavigateTo("/");
    }

    private static string RoomLabel(RoomType type) => type switch { RoomType.Chest => "chest", RoomType.Puzzle => "puzzle", _ => "combat" };

    private static string Describe(LogEntry entry) => entry.RoomType == RoomType.Combat
        ? (entry.TargetName is null ? "No damage" : $"{entry.TargetName} took {entry.Damage} damage")
        : entry.RoomType == RoomType.Puzzle && entry.GoldFound == 0 && entry.Damage > 0
            ? $"{entry.TargetName ?? "A hero"} took {entry.Damage} damage"
            : $"Gold +{entry.GoldFound}";
}
