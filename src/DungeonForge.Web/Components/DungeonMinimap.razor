@using DungeonForge.Web.Models

<div class="minimap" role="img" aria-label="Dungeon map" style="grid-template-columns:repeat(@MinimapLayout.Columns, 1fr)">
    @for (var i = 0; i < _tiles.Count; i++)
    {
        var tile = _tiles[i];
        var position = MinimapLayout.Position(i);
        var current = i == _currentIndex;
        <div class="@TileClass(tile, current)"
             style="grid-row:@(position.Row + 1);grid-column:@(position.Col + 1)">
            @if (tile.Room is { } room)
            {
                <span class="marker marker-@room.ToString().ToLowerInvariant()" title="@room"></span>
            }
            else
            {
                <span class="unknown" aria-hidden="true">?</span>
            }
            @if (current)
            {
                <span class="tokens">
                    @foreach (var member in Members)
                    {
                        <span class="token@(member.IsDefeated ? " defeated" : "")" title="@member.Name"></span>
                    }
                </span>
            }
        </div>
    }
</div>

@code {
    private sealed record Tile(RoomType? Room);

    private static string TileClass(Tile tile, bool current) =>
        "tile" + (tile.Room is null ? " unexplored" : "") + (current ? " current pulse" : "");

    private List<Tile> _tiles = [];
    private int _currentIndex = -1;

    [Parameter] public IReadOnlyList<LogEntry> Log { get; set; } = [];
    [Parameter] public IReadOnlyList<MemberDto> Members { get; set; } = [];
    [Parameter] public RoomType? PendingRoom { get; set; }

    protected override void OnParametersSet()
    {
        _tiles = [.. Log.Select(e => new Tile(e.RoomType))];
        if (PendingRoom is not null) _tiles.Add(new Tile(null));
        _currentIndex = _tiles.Count == 0 ? -1 : Math.Max(0, Log.Count - 1);
    }
}
