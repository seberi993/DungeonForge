@using DungeonForge.Shared
@using DungeonForge.Web.Models
@using DungeonForge.Web.Services
@inject DungeonApiClient Api
@inject GameSession Session

@* Before any room exists the DM asks each player one question; the party's free-text answers become the world. *@
<section id="scene-painter" class="scene-painter card">
    <h2>Paint the world</h2>
    @if (_setup is null)
    {
        <p id="scene-loading" class="scene-wait">@(_error ?? "The dungeon master is gathering their thoughts...")</p>
    }
    else if (!_setup.Answered)
    {
        <p id="scene-question" class="scene-question">@_setup.Question</p>
        <textarea id="scene-answer" maxlength="@Limits.MaxSetupAnswerLength" placeholder="Describe it in your own words" disabled="@_busy"
                  @bind="_text" @bind:event="oninput"></textarea>
        <div class="action-buttons">
            <button id="scene-submit" class="btn btn-go btn-big" disabled="@(_busy || string.IsNullOrWhiteSpace(_text))" @onclick="SubmitAsync">Tell the dungeon master</button>
            <span class="char-count">@_text.Length/@Limits.MaxSetupAnswerLength</span>
        </div>
    }
    else
    {
        <p id="scene-waiting" class="scene-wait">Your words are written. Waiting for the others to paint their part (@Session.SetupAnswered of @Session.Members.Count).</p>
        <button id="scene-force" class="btn btn-ghost" disabled="@_busy" @onclick="StartWithoutThemAsync">Begin without them</button>
    }

    @if (_error is not null && _setup is not null)
    {
        <p id="scene-error" class="error">@_error</p>
    }
</section>

@code {
    private SetupDto? _setup;
    private string _text = "";
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetSetupAsync(Session.PartyId, Session.PlayerName);
        if (result.IsSuccess)
        {
            _setup = result.Value;
            Session.ApplySetupProgress(_setup!.Pending, _setup.AnsweredCount);
        }
        else
        {
            _error = result.Error ?? "Could not reach the dungeon master.";
        }
    }

    private Task SubmitAsync() => SendAsync(_text.Trim(), forceStart: false);

    // The server keeps the answer already given when it is forced, so an empty answer is never sent.
    private Task StartWithoutThemAsync() => SendAsync(null, forceStart: true);

    private async Task SendAsync(string? text, bool forceStart)
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Api.SubmitSetupAsync(Session.PartyId, Session.PlayerName, text ?? "(begins the tale)", forceStart);
            if (result.IsSuccess)
            {
                var done = result.Value!;
                _setup = _setup! with { Answered = true, AnsweredCount = done.AnsweredCount, Pending = done.Pending };
                Session.ApplySetupProgress(done.Pending, done.AnsweredCount);
            }
            else if (result.Status == ApiStatus.Conflict)
            {
                // Already answered, or the scene is already painted: the server's word wins.
                _setup = _setup! with { Answered = true };
            }
            else
            {
                _error = result.Error ?? "The dungeon master did not hear that. Try again.";
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
