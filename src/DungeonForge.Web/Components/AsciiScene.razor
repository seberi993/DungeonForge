@implements IDisposable
@using DungeonForge.Web.Models

<pre class="ascii-scene" role="img" aria-label="Scene: @AsciiArt.Tag(Scene, Room)">@Frames[_frame % Frames.Length]</pre>

@code {
    private int _frame;
    private CancellationTokenSource? _cts;

    [Parameter] public string? Scene { get; set; }
    [Parameter] public RoomType? Room { get; set; }
    [Parameter] public TimeSpan Interval { get; set; } = TimeSpan.FromMilliseconds(600);

    private string[] Frames => AsciiArt.Frames(Scene, Room);

    protected override void OnInitialized()
    {
        _cts = new CancellationTokenSource();
        _ = AnimateAsync(_cts.Token);
    }

    private async Task AnimateAsync(CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(Interval);
            while (await timer.WaitForNextTickAsync(ct))
            {
                _frame++;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
