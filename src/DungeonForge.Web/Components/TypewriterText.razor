@implements IDisposable

@* Types Text out at CharsPerSecond (0 = instantly). **word** segments render highlighted. Unrevealed text stays in the DOM
   (hidden) so layout does not jump; click to skip. *@
<span class="typewriter@(Typing ? " typing" : "")" @onclick="Skip">
    @{ var left = _shown; }
    @foreach (var (text, key) in _segments)
    {
        var take = Math.Min(left, text.Length);
        left -= take;
        <span class="@(key ? "key" : null)">@text[..take]</span>
        @if (take < text.Length)
        {
            <span class="tw-rest @(key ? "key" : null)">@text[take..]</span>
        }
    }
</span>

@code {
    private List<(string Text, bool Key)> _segments = [];
    private string? _text;
    private int _total;
    private int _shown;
    private CancellationTokenSource? _cts;

    private bool _started;

    [Parameter] public string? Text { get; set; }
    [Parameter] public int CharsPerSecond { get; set; } = 40;
    // While true the text stays hidden and typing has not begun (lets a second block wait for the first).
    [Parameter] public bool Hold { get; set; }
    [Parameter] public EventCallback OnComplete { get; set; }

    private bool Typing => _shown < _total;

    protected override void OnParametersSet()
    {
        if (Text != _text)
        {
            _text = Text;
            _segments = Parse(Text);
            _total = _segments.Sum(s => s.Text.Length);
            _cts?.Cancel();
            _cts?.Dispose();
            _cts = null;
            _started = false;
            _shown = 0;
        }

        if (_started || Hold) return;

        _started = true;
        if (CharsPerSecond <= 0 || _total == 0)
        {
            _shown = _total;
            _ = OnComplete.InvokeAsync();
            return;
        }

        _cts = new CancellationTokenSource();
        _ = TypeAsync(_cts.Token);
    }

    private async Task TypeAsync(CancellationToken ct)
    {
        var delay = TimeSpan.FromMilliseconds(1000.0 / CharsPerSecond);
        try
        {
            while (_shown < _total)
            {
                await Task.Delay(delay, ct);
                _shown++;
                await InvokeAsync(StateHasChanged);
            }

            await InvokeAsync(() => OnComplete.InvokeAsync());
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
        }
    }

    private void Skip()
    {
        if (Hold || !Typing) return;
        _cts?.Cancel();
        _shown = _total;
        _ = OnComplete.InvokeAsync();
    }

    // "a **b** c" -> [("a ", false), ("b", true), (" c", false)]; an unmatched ** is kept as plain text.
    public static List<(string Text, bool Key)> Parse(string? text)
    {
        var result = new List<(string, bool)>();
        if (string.IsNullOrEmpty(text)) return result;

        var parts = text.Split("**");
        var balanced = parts.Length % 2 == 1;
        for (var i = 0; i < parts.Length; i++)
        {
            if (parts[i].Length == 0) continue;
            var key = balanced && i % 2 == 1;
            result.Add((!balanced && i > 0 ? "**" + parts[i] : parts[i], key));
        }

        return result;
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
