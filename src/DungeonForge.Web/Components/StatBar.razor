<div class="stat-bar @Kind-bar" role="progressbar" aria-label="@Label" aria-valuemin="0" aria-valuenow="@Value" aria-valuemax="@Max">
    <div class="stat-fill @Kind-fill@(IsLow ? " " + Kind + "-low" : "")" style="width:@Percent%"></div>
    <span class="stat-text"><span class="stat-label">@Label</span> <span class="@Kind-value">@Value/@Max</span></span>
</div>

@code {
    // Kind picks the colour theme and class names: "hp", "mana" or "boss".
    [Parameter] public string Kind { get; set; } = "hp";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public int Value { get; set; }
    [Parameter] public int Max { get; set; }

    private int Percent => Max <= 0 ? 0 : (int)Math.Round(Math.Clamp(Value, 0, Max) * 100.0 / Max);
    private bool IsLow => Percent <= 30;
}
