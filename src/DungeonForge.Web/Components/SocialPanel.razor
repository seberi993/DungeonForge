@using DungeonForge.Web.Models
@using DungeonForge.Web.Services
@inject DungeonApiClient Api
@inject GameSession Session
@inject IDungeonHubClient Hub
@implements IDisposable

@* The social game in one self-contained panel: the door's question, teammate micro-prompts, your gifts and private whispers.
   It renders nothing when the server has the social game switched off (every call answers 404), so it can be removed from
   the room without touching anything else. Only flavor is shown: tags and words, never a number. *@
@if (_me is { } me)
{
    <section id="social" class="social-panel" aria-label="The dungeon's measure of you">
        @if (me.SeedQuestion is { } question)
        {
            <div id="seed" class="social-card">
                <p class="social-prompt">@question</p>
                <textarea id="seed-answer" maxlength="140" placeholder="Answer in a line" @bind="_seed" @bind:event="oninput"></textarea>
                <button id="seed-submit" class="btn btn-go" disabled="@(_busy || _seed.Trim().Length < 5)" @onclick="SubmitSeedAsync">Answer the door</button>
            </div>
        }
        else if (me.Tags.Count > 0)
        {
            <p id="social-tags" class="social-tags">The dungeon sees you as <strong>@string.Join(", ", me.Tags)</strong>.</p>
        }

        @if (me.Seeded && !me.Finalized)
        {
            <p id="seed-waiting" class="social-hint">Waiting for the others to answer.
                <button id="seed-start" class="btn btn-ghost" disabled="@_busy" @onclick="StartWithoutWaitingAsync">Start without them</button></p>
        }

        @if (_prompt is { } prompt)
        {
            <div id="peer-prompt" class="social-card">
                <p class="social-prompt">@prompt.Question</p>
                <div class="social-choices">
                    @foreach (var choice in prompt.Options)
                    {
                        <button class="btn btn-ghost peer-choice peer-@choice" disabled="@_busy" @onclick="() => AnswerPeerAsync(prompt, choice)">@Label(choice)</button>
                    }
                </div>
            </div>
        }

        @if (me.Abilities.Count > 0)
        {
            <ul id="abilities" class="abilities" aria-label="Your gifts">
                @foreach (var ability in me.Abilities)
                {
                    var chosen = Session.SelectedAbilityId == ability.Id;
                    <li class="ability @(chosen ? "chosen" : "") @(ability.Ready ? "" : "recovering")">
                        <button class="ability-pick" disabled="@(!ability.Ready)" aria-pressed="@chosen" @onclick="() => ToggleAbility(ability)">
                            <strong class="ability-name">@ability.Name</strong>
                            <span class="ability-flavor">@ability.Flavor</span>
                            <span class="ability-hint">@(ability.Ready ? ability.Hint : "Recovering...")</span>
                        </button>
                    </li>
                }
            </ul>
        }

        @if (me.AsksAvailable)
        {
            <div id="asks" class="social-card">
                <p class="social-hint">Whisper-shards: <strong id="ask-tokens">@me.AskTokens</strong></p>
                @if (me.Inbox.Count > 0)
                {
                    <ul id="inbox" class="inbox">
                        @foreach (var ask in me.Inbox)
                        {
                            <li class="inbox-ask">
                                <p><strong>@ask.From</strong> whispers (@ask.Kind): @ask.Text</p>
                                @if (ask.Replied)
                                {
                                    <span class="social-hint">You answered.</span>
                                }
                                else
                                {
                                    <input class="reply-text" maxlength="80" placeholder="Your answer" value="@ReplyText(ask)" @oninput="e => _replyText[ask.AskId] = e.Value?.ToString() ?? string.Empty" />
                                    <button class="btn btn-ghost reply-honest" disabled="@_busy" @onclick='() => ReplyAsync(ask, "honest")'>I'll be honest</button>
                                    <button class="btn btn-ghost reply-dodge" disabled="@_busy" @onclick='() => ReplyAsync(ask, "dodge")'>I'll dodge</button>
                                    <button class="btn btn-ghost reply-bluff" disabled="@_busy" @onclick='() => ReplyAsync(ask, "bluff")'>I'll bluff</button>
                                }
                            </li>
                        }
                    </ul>
                }

                @if (me.Sent.Count > 0)
                {
                    <ul id="sent" class="sent">
                        @foreach (var ask in me.Sent)
                        {
                            <li>To @string.Join(", ", ask.To): "@ask.Text"
                                @foreach (var reply in ask.Replies)
                                {
                                    <div class="sent-reply"><strong>@reply.By</strong> @reply.Summary</div>
                                }
                            </li>
                        }
                    </ul>
                }

                <details id="ask-composer">
                    <summary>Whisper to...</summary>
                    <div class="ask-targets">
                        @foreach (var other in Session.Members.Where(m => m.Name != Session.PlayerName && !m.IsDefeated))
                        {
                            <label class="ask-target"><input type="checkbox" checked="@_askTo.Contains(other.Name)" @onchange="e => ToggleTarget(other.Name, e.Value is true)" /> @other.Name</label>
                        }
                    </div>
                    <select id="ask-kind" @bind="_askKind">
                        <option value="question">Question</option>
                        <option value="accusation">Accuse</option>
                        <option value="offer">Offer</option>
                        <option value="plea">Plead</option>
                    </select>
                    <input id="ask-text" maxlength="140" placeholder="Costs 1 whisper-shard" @bind="_askText" @bind:event="oninput" />
                    <button id="ask-send" class="btn btn-go" disabled="@(_busy || _askTo.Count == 0 || _askText.Trim().Length == 0 || me.AskTokens < _askTo.Count)" @onclick="SendAskAsync">Whisper</button>
                </details>
            </div>
        }

        @if (_error is not null)
        {
            <p id="social-error" class="error">@_error</p>
        }
    </section>
}

@code {
    private MySocialDto? _me;
    private PeerPromptDto? _prompt;
    private string _seed = "";
    private string _askKind = "question";
    private string _askText = "";
    private readonly HashSet<string> _askTo = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _replyText = [];
    private string? _error;
    private bool _busy;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        Hub.PrivateMessageReceived += OnPrivate;
        Hub.NarrationReady += OnNarration;
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        var mine = await Api.GetMySocialAsync(Session.PartyId, Session.PlayerName);
        if (_disposed) return;
        // Anything that is not a full social overview (an error, or some other service's body) means "no social game here".
        if (!mine.IsSuccess || mine.Value is not { Tags: not null, Abilities: not null, Inbox: not null, Sent: not null })
        {
            _me = null;
            _prompt = null;
            return;
        }

        _me = mine.Value;
        _prompt = null;
        if (_me!.Seeded)
        {
            var prompt = await Api.GetPeerPromptAsync(Session.PartyId, Session.PlayerName);
            if (!_disposed && prompt.IsSuccess) _prompt = prompt.Value;
        }
    }

    // Whispers, narrator words and a new turn all change what the panel should show.
    private void OnPrivate(PrivateMessageDto message)
    {
        if (message.Kind is "ask" or "narrator") _ = ReloadAsync();
    }

    private void OnNarration(NarrationReady narration) => _ = ReloadAsync();

    private async Task ReloadAsync()
    {
        if (_disposed) return;
        try
        {
            await InvokeAsync(async () =>
            {
                await RefreshAsync();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task RunAsync(Func<Task<string?>> action)
    {
        _busy = true;
        _error = null;
        try
        {
            _error = await action();
            await RefreshAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private static string? Failure<T>(ApiResult<T> result) where T : class => result.IsSuccess ? null : result.Error ?? "Something went wrong. Try again.";

    private Task SubmitSeedAsync() => RunAsync(async () =>
    {
        var result = await Api.SubmitSeedAsync(Session.PartyId, Session.PlayerName, _seed.Trim());
        if (result.IsSuccess) _seed = "";
        return Failure(result);
    });

    private Task StartWithoutWaitingAsync() => RunAsync(async () =>
        Failure(await Api.FinalizeSocialAsync(Session.PartyId, Session.PlayerName)));

    private Task AnswerPeerAsync(PeerPromptDto prompt, string choice) => RunAsync(async () =>
        Failure(await Api.SubmitPeerAnswerAsync(Session.PartyId, Session.PlayerName, prompt.PromptId, choice)));

    private void ToggleAbility(AbilityDto ability) =>
        Session.SelectedAbilityId = Session.SelectedAbilityId == ability.Id ? null : ability.Id;

    private void ToggleTarget(string name, bool on)
    {
        if (on) _askTo.Add(name);
        else _askTo.Remove(name);
    }

    private Task SendAskAsync() => RunAsync(async () =>
    {
        var result = await Api.SendAskAsync(Session.PartyId, Session.PlayerName, [.. _askTo], _askText.Trim(), _askKind);
        if (result.IsSuccess)
        {
            _askText = "";
            _askTo.Clear();
        }

        return Failure(result);
    });

    private Task ReplyAsync(InboxAskDto ask, string choice) => RunAsync(async () =>
    {
        var text = _replyText.GetValueOrDefault(ask.AskId)?.Trim();
        return Failure(await Api.ReplyAskAsync(Session.PartyId, ask.AskId, Session.PlayerName, choice, string.IsNullOrEmpty(text) ? null : text));
    });

    private string ReplyText(InboxAskDto ask) => _replyText.GetValueOrDefault(ask.AskId) ?? string.Empty;

    private static string Label(string choice) => choice switch
    {
        "yes" => "Yes",
        "maybe" => "Maybe",
        "no" => "No",
        _ => choice,
    };

    public void Dispose()
    {
        _disposed = true;
        Hub.PrivateMessageReceived -= OnPrivate;
        Hub.NarrationReady -= OnNarration;
    }
}
